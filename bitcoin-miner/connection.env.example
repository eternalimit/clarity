# Anchoin Miner connection settings
# Public pool endpoints verified against current Braiins documentation.
ANCHOIN_POOL_URL=stratum+tcp://stratum.braiins.com:3333
ANCHOIN_POOL_BACKUP_URL=stratum+tcp://stratum.braiins.com:443

# REQUIRED USER-SPECIFIC VALUES
# Replace with the miner LAN IP or hostname visible on your router/miner UI.
ANCHOIN_MINER_HOST=REPLACE_WITH_MINER_LAN_IP

# Braiins Pool identity format: userName.workerName
ANCHOIN_POOL_USER=REPLACE_WITH_USERNAME.WORKER

# Password is typically unused by Braiins Pool and may be any value or empty.
ANCHOIN_POOL_PASS=x

# Miner executable must be installed on the controller/miner host.
# Example only; use the exact executable for your hardware/software.
ANCHOIN_MINER_BIN=REPLACE_WITH_MINER_EXECUTABLE
